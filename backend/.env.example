# Copy to .env and fill in real values. Never commit .env.
#
# Local Postgres example:
#   DATABASE_URL=postgresql+psycopg://audit_app:changeme@localhost:5432/audit_platform
# Neon example (rotate any credential that has ever been pasted/shared before using it here):
#   DATABASE_URL=postgresql+psycopg://neondb_owner:REPLACE_ME@ep-xxxx-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://audit_app:changeme@localhost:5432/audit_platform

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-never-committed
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
